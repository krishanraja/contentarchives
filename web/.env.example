# Symbolic names only. Real values live in Vercel's environment, never here.
DATABASE_URL=            # Supabase pooler, transaction mode
SESSION_SECRET=          # 32+ random bytes; also keys the hashes of emailed codes
SESSION_VERSION=1        # bumping it signs everyone out
RESEND_API_KEY=          # sending only, this app only: the codes and Krish's yes-or-no emails
MAIL_FROM=               # e.g. Family Archives <hello@krishraja.com>, on a domain verified in Resend
ACCESS_ADMIN_EMAIL=      # Krish: asked to say yes or no to each new person, and let straight in himself
MAIL_SINK=               # local tests only: write emails to this file instead of sending; refused on Vercel
IMAGE_SOURCE=drive       # drive | fixture
GOOGLE_SERVICE_ACCOUNT_JSON=   # Viewer on the Communal folder ONLY
DRIVE_COMMUNAL_FOLDER_ID=
DRIVE_REL_PREFIX=Media/Communal
GOOGLE_API_KEY_ARCHIVES= # Gemini, quota-capped, this app only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
ALERT_WEBHOOK_URL=       # optional: told when sign-in locks after too many wrong codes
